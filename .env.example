# Saytning asosiy manzili: sitemap, robots va canonical shu yerdan olinadi.
NEXT_PUBLIC_SITE_URL=https://bolalar-ijodkorligi.uz

# Aloqa shakli xabarni Telegramga yuboradi. Ikkalasi boʻlmasa shakl oʻrniga toʻgʻridan-toʻgʻri havola chiqadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase: manzil va publishable kalit faqat serverda oʻqiladi (kontent RPC si, /uploads rewrite,
# panelning kirish va maʼlumot soʻrovlari, panel CSP sidagi ruxsat etilgan manba); brauzer kodiga tushmaydi.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase ning ochiq kaliti (sb_publishable_…): foydalanuvchi tokeni bilan ishlaydi, RLS ostida.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Panel egasining Supabase foydalanuvchi id si (uuid): boshqa hisob parol toʻgʻri boʻlsa ham kira olmaydi.
ADMIN_USER_ID=
# Maxfiy kalit faqat shu faylda (pnpm content:seed uchun); Vercel ga hech qachon qoʻyilmaydi.
SUPABASE_SERVICE_ROLE_KEY=

# Kontent manbai: bundled (standart, src/content/snapshot.json) yoki supabase (Vercel Production va Preview).
CONTENT_SOURCE=
# Yigʻishda baza javob bermasa: fail (production da standart) yoki bundled (favqulodda qayta deploy uchun).
CMS_BUILD_FALLBACK=
