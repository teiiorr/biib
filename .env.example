# Saytning asosiy manzili: sitemap, robots va canonical havolalar shundan tuziladi.
NEXT_PUBLIC_SITE_URL=https://bolalar-ijodkorligi.uz

# Aloqa shakli xabarni Telegramga yuboradi. Ikkalasi berilmasa, shakl oʻrnida kanal havolasi chiqadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase manzili va ochiq kaliti faqat serverda oʻqiladi, brauzer kodiga tushmaydi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Boshqaruv paneliga kira oladigan yagona foydalanuvchining id raqami (uuid).
ADMIN_USER_ID=
# Maxfiy kalit: faqat mahalliy faylda turadi (pnpm content:seed uchun), hostingga qoʻyilmaydi.
SUPABASE_SERVICE_ROLE_KEY=

# Kontent manbai: bundled (standart, src/content/snapshot.json) yoki supabase.
CONTENT_SOURCE=
# Yigʻish paytida baza javob bermasa: fail (standart) yoki bundled (shoshilinch qayta yigʻish uchun).
CMS_BUILD_FALLBACK=

# Kunlik cron soʻrovi (/admin/api/keepalive) shu kalit bilan keladi.
CRON_SECRET=
